//Przeliczanie jednostek długości
void task17()
{
	int option;
	double length;

	std::cout << "1 - metry na centymetry\n";
	std::cout << "2 - centymetry na metry\n";
	std::cout << "3 - kilometry na metry\n";
	std::cout << "Podaj numer opcji\n";
	std::cin >> option;
	std::cout << "Podaj długość do przeliczenia\n";
	std::cin >> length;

	switch (option)
	{
	case 1:
		std::cout << length << " m = " << length * 100 << " cm\n";
		break;
	case 2:
		std::cout << length << " cm = " << length / 100 << " m\n";
		break;
	case 3:
		std::cout << length << " km = " << length * 1000 << " m\n";
		break;
	default:
		std::cout << "Błędny wybór\n";
	}
}

