//Pakowanie produktów
void task11()
{
	int productCount;
	std::cout << "Podaj liczbę produktów\n";
	std::cin >> productCount;

	if (productCount <= 0)
	{
		std::cout << "Liczba produktów musi być dodatnia\n";
	}
	else
	{
		//reszta z dzielenia równa 0 oznacza, że nic nie zostaje luzem
		bool packsOfThree = productCount % 3 == 0;
		bool packsOfFive = productCount % 5 == 0;

		if (packsOfThree)
			std::cout << "Można zapakować po 3 sztuki\n";
		else
			std::cout << "Nie można zapakować po 3 sztuki\n";

		if (packsOfFive)
			std::cout << "Można zapakować po 5 sztuk\n";
		else
			std::cout << "Nie można zapakować po 5 sztuk\n";

		if (packsOfThree && packsOfFive)
			std::cout << "Oba sposoby pakowania są możliwe\n";
		else
			std::cout << "Oba sposoby pakowania nie są możliwe jednocześnie\n";
	}
}

//Bilet ulgowy
void task12()
{
	int age;
	double normalPrice;
	std::cout << "Podaj wiek pasażera\n";
	std::cin >> age;
	std::cout << "Podaj cenę biletu normalnego\n";
	std::cin >> normalPrice;

	double price = normalPrice;

	if (age < 18 || age >= 65)
	{
		price = normalPrice * 0.5;
		std::cout << "Zastosowano ulgę 50%\n";
	}
	else
	{
		std::cout << "Nie zastosowano ulgi\n";
	}

	std::cout << "Cena biletu: " << price << " zł\n";
}

