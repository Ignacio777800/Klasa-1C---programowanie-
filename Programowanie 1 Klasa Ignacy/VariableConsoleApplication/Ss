//Kontrola liczby produktów
void task8()
{
	int ordered, delivered;
	std::cout << "Podaj liczbę zamówionych sztuk\n";
	std::cin >> ordered;
	std::cout << "Podaj liczbę dostarczonych sztuk\n";
	std::cin >> delivered;

	if (ordered == delivered)
		std::cout << "Dostawa jest zgodna z zamówieniem\n";
	else if (delivered < ordered)
		std::cout << "Brakuje " << ordered - delivered << " sztuk\n";
	else
		std::cout << "Dostarczono za dużo o " << delivered - ordered << " sztuk\n";
}

